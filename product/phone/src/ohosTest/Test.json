{
  "description": "Configuration for soundRecorder Tests",
  "driver": {
    "type": "OHJSUnitTest",
    "test-timeout": "600000",
    "bundle-name": "com.ohos.soundrecorder",
    "module-name": "entry_test",
    "shell-timeout": "3600000",
    "testcase-timeout": "300000",
    "compile-mode": "esmodule",
    "coverage": true,
    "package-tool-path": "D:\\Local\\coverage2.0\\node_modules\\@ohos\\coverage"
  },
  "kits": [
    {
      "test-file-name": [
        "soundRecorder.hap",
        "soundRecorderTest.hap"
      ],
      "type": "AppInstallKit",
      "cleanup-apps": true
    },
    {
      "type": "ShellKit",
      "run-command": [
        "param set persist.usb.setting.gadget_conn_prompt false",
        "reboot",
        "wait 5",
        "power-shell wakeup",
        "uinput -T -m 540 1752 540 751 500",
        "power-shell timeout -o 1800000",
        "power-shell setmode 602",
        "uinput -T -c 630 1683"
      ],
      "teardown-command":[
        "power-shell setmode 600"
      ]
    }
  ]
}
