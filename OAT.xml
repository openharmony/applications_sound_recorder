<configuration>
    <oatconfig>
        <licensefile></licensefile>
        <policylist>
            <policy name="projectPolicy" desc="">
                <policyitem type="copyright" name="Huawei Device Co., Ltd." path=".*"
                            rule="may" group="defaultGroup" filefilter="copyrightPolicyFilter" desc=""/>
            </policy>
        </policylist>
        <filefilterlist>
            <filefilter name="defaultFilter" desc="Files not to check">
                <filteritem type="filename" name="*.json" desc="Resource and project configuration files"/>
                <filteritem type="filepath" name=".*.json5" desc="Build configuration files"/>
                <filteritem type="filepath" name="signature/.*" desc="Signing material"/>
                <filteritem type="filepath" name="sign/.*" desc="Signing output files"/>
                <filteritem type="filepath" name="gradle/.*" desc="Build tool files"/>
                <filteritem type="filepath" name="hvigor/.*" desc="Build tool files"/>
                <filteritem type="filepath" name=".*/build/.*" desc="Build output files"/>
                <filteritem type="filepath" name=".*/oh_modules/.*" desc="Dependency output files"/>
                <filteritem type="filepath" name="oh_modules/.*" desc="Dependency output files"/>
                <filteritem type="filename"
                            name="*.png|*.PNG|*.jpg|*.jpeg|*.webp|*.gif|*.mp3|*.mp4|*.wav|*.ogg|*.ttf|*.ap"
                            desc="Application media resources"/>
            </filefilter>
            <filefilter name="defaultPolicyFilter"
                        desc="Filters for compatibility and license header policies">
            </filefilter>
            <filefilter name="copyrightPolicyFilter"
                        desc="Filters for copyright header policies">
            </filefilter>
            <filefilter name="licenseFileNamePolicyFilter"
                        desc="Filters for LICENSE file policies">
            </filefilter>
            <filefilter name="readmeFileNamePolicyFilter"
                        desc="Filters for README file policies">
            </filefilter>
            <filefilter name="readmeOpenSourcefileNamePolicyFilter"
                        desc="Filters for README.OpenSource file policies">
            </filefilter>
            <filefilter name="binaryFileTypePolicyFilter"
                        desc="Filters for binary file policies">
                <filteritem type="filepath" name=".*/src/.*/resources/.*/media/.*.png"
                            desc="Application image resource"/>
                <filteritem type="filepath" name=".*/src/.*/resources/.*/media/.*.svg"
                            desc="Application vector image resource"/>
                <filteritem type="filepath" name=".*/src/.*/resources/rawfile/.*.svg"
                            desc="Application vector image resource"/>
                <filteritem type="filepath" name="AppScope/resources/.*/media/.*"
                            desc="Application icon resource"/>
                <filteritem type="filepath"
                            name="feature/recorder/src/main/resources/rawfile/grs_config/config/cbg_root.pem"
                            desc="GRS root certificate"/>
                <filteritem type="filename" name="*.ets|*.hpp"
                            desc="File is recognized as a binary file"/>
            </filefilter>
        </filefilterlist>
        <licensematcherlist>
        </licensematcherlist>
    </oatconfig>
</configuration>
